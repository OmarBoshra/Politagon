import '../bloc/grid_game_event.dart';
import '../models/game_state.dart';
import '../models/position.dart';
import '../utilities/grid_generator.dart';

class GameStateBuilder {
  static GameState onCellTapGameState(GameState state, GridGameEvent event, Position pos) {
    String? playerId;
    if (event is UserMoveEvent) playerId = event.playerId;
    if (event is AiMoveEvent) playerId = event.playerId;

    if (playerId != null) {
      final cellValue = state.grid[pos.x][pos.y];
      final playerIndex = state.players.indexWhere((p) => p.id == playerId);
      if (playerIndex == -1) return state;
      final currentPlayer = state.players[playerIndex];

      // 1. Calculate Target Quality
      final centerIdx = state.gridSize ~/ 2;
      final distance = (pos.x - centerIdx).abs() + (pos.y - centerIdx).abs();
      final maxDist = centerIdx * 2; 
      
      final targetQuality = (maxDist + 1 - distance) / (maxDist + 1).toDouble(); 
      final extremeQuality = targetQuality * targetQuality;

      // 2. Acquisition Logic
      final eliteCaptureNeed = extremeQuality;
      final grassrootsCaptureNeed = 1.0 - extremeQuality;
      
      final captureRate = (currentPlayer.popularity * eliteCaptureNeed + 
                           currentPlayer.influence * grassrootsCaptureNeed).clamp(0.05, 1.0);
      
      final pointsGained = (cellValue * captureRate).ceil();

      // 3. Determine Social Class of Points
      SocialClass gainedClass;
      if (distance == 0) gainedClass = SocialClass.elite;
      else if (distance == 1) gainedClass = SocialClass.noble;
      else if (distance == 2) gainedClass = SocialClass.middle;
      else if (distance == 3) gainedClass = SocialClass.layman;
      else gainedClass = SocialClass.poor;

      // 4. Tax/Apathy Check
      final currentTotalScore = state.players.fold(0, (sum, p) => sum + p.score);
      final bool isTaxEvent = (currentTotalScore + pointsGained) > state.winThreshold;
      final double frustrationPenalty = isTaxEvent ? 0.5 : 1.0;

      // 5. Stat Recalibration
      double newInfluence;
      double newPopularity;
      
      if (currentPlayer.score == 0 && pointsGained == 0) {
        newInfluence = currentPlayer.influence;
        newPopularity = currentPlayer.popularity;
      } else {
        const double baseWeight = 1.0; 
        final double currentWeight = currentPlayer.score.toDouble();
        final double totalWeight = currentWeight + pointsGained + baseWeight;
        
        final double infContributionWeight = (0.15 + (0.70 * extremeQuality)) * frustrationPenalty;
        final double popContributionWeight = (0.15 + (0.70 * (1.0 - extremeQuality))) * frustrationPenalty;

        final double infWeightedSum = (currentPlayer.influence * currentWeight) + 
                                      (pointsGained * infContributionWeight) + 
                                      (0.1 * baseWeight); 
        newInfluence = (infWeightedSum / totalWeight).clamp(0.05, 1.0);

        final double popWeightedSum = (currentPlayer.popularity * currentWeight) + 
                                      (pointsGained * popContributionWeight) + 
                                      (0.1 * baseWeight);
        newPopularity = (popWeightedSum / totalWeight).clamp(0.05, 1.0);
      }

      // 6. Apply Gains and Taxation
      final apathyResult = _computeNewPlayerStatesAndApathy(
        players: state.players,
        currentPlayerId: playerId,
        pointsGained: pointsGained,
        gainedClass: gainedClass,
        newPos: pos,
        newInfluence: newInfluence,
        newPopularity: newPopularity,
        winThreshold: state.winThreshold,
        currentFrustrated: state.frustratedCount,
        currentWithdrawn: state.withdrawnCount,
      );

      final nextTurn = _getNextTurn(apathyResult.players, playerId);
      final initialMax = state.maxNationalPool;
      final targetSum = (initialMax - apathyResult.withdrawnCount).clamp(0, initialMax);

      return state.copyWith(
        players: apathyResult.players,
        grid: GridGenerator.generate(state.gridSize, state.gridSize, targetSum),
        turn: nextTurn,
        frustratedCount: apathyResult.frustratedCount,
        withdrawnCount: apathyResult.withdrawnCount,
      );
    }
    return state;
  }

  static String _getNextTurn(List<GamePlayerState> players, String currentPlayerId) {
    final currentIndex = players.indexWhere((p) => p.id == currentPlayerId);
    if (currentIndex == -1) return players.first.id;
    final nextIndex = (currentIndex + 1) % players.length;
    return players[nextIndex].id;
  }

  static _ApathyResult _computeNewPlayerStatesAndApathy({
    required List<GamePlayerState> players,
    required String currentPlayerId,
    required int pointsGained,
    required SocialClass gainedClass,
    required Position newPos,
    required double newInfluence,
    required double newPopularity,
    required int winThreshold,
    required int currentFrustrated,
    required int currentWithdrawn,
  }) {
    var newPlayers = players.map((p) {
      if (p.id == currentPlayerId) {
        final newVotes = Map<SocialClass, int>.from(p.votes);
        newVotes[gainedClass] = (newVotes[gainedClass] ?? 0) + pointsGained;
        return p.copyWith(
          pos: newPos,
          votes: newVotes,
          influence: newInfluence,
          popularity: newPopularity,
        );
      }
      return p;
    }).toList();

    int frustratedAdded = 0;
    final totalScore = newPlayers.fold(0, (sum, p) => sum + p.score);

    if (totalScore > winThreshold) {
      final excess = totalScore - winThreshold;
      frustratedAdded = excess;

      final nonMovingPlayers = newPlayers.where((p) => p.id != currentPlayerId).toList();
      final nonMovingTotal = nonMovingPlayers.fold(0, (sum, player) => sum + player.score);

      if (nonMovingTotal > 0) {
        int distributed = 0;
        newPlayers = newPlayers.map((p) {
          if (p.id == currentPlayerId) return p;
          int penalty = (excess * p.score ~/ nonMovingTotal);
          final actualPenalty = penalty.clamp(0, p.score);
          distributed += actualPenalty;
          
          final newVotes = _applyTaxToVotes(p.votes, actualPenalty);
          return p.copyWith(votes: newVotes);
        }).toList();

        final remainingPenalty = excess - distributed;
        if (remainingPenalty > 0) {
           newPlayers = newPlayers.map((p) {
             if (p.id == currentPlayerId) {
               final newVotes = _applyTaxToVotes(p.votes, remainingPenalty);
               return p.copyWith(votes: newVotes);
             }
             return p;
           }).toList();
        }
      } else {
        newPlayers = newPlayers.map((p) {
          if (p.id == currentPlayerId) {
            final newVotes = _applyTaxToVotes(p.votes, excess);
            return p.copyWith(votes: newVotes);
          }
          return p;
        }).toList();
      }
    }

    int withdrawingThisTurn = (currentFrustrated * 0.2).floor();
    if (withdrawingThisTurn < 1 && currentFrustrated > 0) withdrawingThisTurn = 1;
    
    final finalFrustrated = (currentFrustrated + frustratedAdded - withdrawingThisTurn).clamp(0, 9999);
    final finalWithdrawn = currentWithdrawn + withdrawingThisTurn;

    return _ApathyResult(
      players: newPlayers,
      frustratedCount: finalFrustrated,
      withdrawnCount: finalWithdrawn,
    );
  }

  static Map<SocialClass, int> _applyTaxToVotes(Map<SocialClass, int> votes, int totalTax) {
    final newVotes = Map<SocialClass, int>.from(votes);
    int currentScore = votes.values.fold(0, (s, v) => s + v);
    if (currentScore <= 0) return newVotes;

    int remainingTax = totalTax;
    final classes = SocialClass.values.toList();
    
    for (var sc in classes) {
      if (remainingTax <= 0) break;
      int v = newVotes[sc] ?? 0;
      if (v <= 0) continue;
      
      int tax = (totalTax * v ~/ currentScore).clamp(0, v);
      newVotes[sc] = v - tax;
      remainingTax -= tax;
    }
    
    // Cleanup remainder if rounding issues occur
    if (remainingTax > 0) {
      for (var sc in classes) {
        if (remainingTax <= 0) break;
        int v = newVotes[sc] ?? 0;
        int cleanup = remainingTax.clamp(0, v);
        newVotes[sc] = v - cleanup;
        remainingTax -= cleanup;
      }
    }
    return newVotes;
  }
}

class _ApathyResult {
  final List<GamePlayerState> players;
  final int frustratedCount;
  final int withdrawnCount;
  _ApathyResult({required this.players, required this.frustratedCount, required this.withdrawnCount});
}
